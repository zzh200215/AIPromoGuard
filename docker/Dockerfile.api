# 国内网络可覆盖: --build-arg BASE_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
ARG BASE_IMAGE=python:3.11-slim
FROM ${BASE_IMAGE}

WORKDIR /app

# 避免 Python 写字节码与输出缓冲
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# onnxruntime（chromadb 依赖）运行时需要 libgomp1；fonts-wqy-zenhei 提供 PDF 报告中文字体
# libgl1/libglib2.0-0/libxcb1/libx11-6/libxext6/libxrender1：rapidocr 拉入的 GUI 版 opencv 需要（slim 镜像缺 libxcb.so.1）
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 fonts-wqy-zenhei libgl1 libglib2.0-0 libxcb1 libx11-6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

# 可选离线兜底：wheels/ 目录有 wheel 时先离线直装（--no-deps 防连带拉依赖），
# 后面的主安装即视为已满足——用于镜像源个别大包 CDN 停滞时的人工救急
# （2026-10-08 实测：aliyun 对 opencv_python-5.0.0.93 的节点两次构建僵死，
#  宿主机分块续传拉取后由此注入；平时 wheels/ 只有 .gitkeep，此步为空操作）
COPY wheels/ /wheels/
RUN if ls /wheels/*.whl >/dev/null 2>&1; then pip install --no-index --no-deps /wheels/*.whl; fi

# 国内网络可覆盖: docker build --build-arg PIP_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple
ARG PIP_MIRROR=
COPY requirements.txt .
# BuildKit 缓存挂载：wheel 缓存跨构建复用——requirements 变更时只下载新增/缺失包，
# 而不是全量重装（实测无缓存挂载时：加一个依赖触发 ~180 包全量下载，~40 分钟）。
# 注意：必须去掉 --no-cache-dir，否则缓存挂载形同虚设。
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    if [ -n "$PIP_MIRROR" ]; then \
        pip install -i "$PIP_MIRROR" -r requirements.txt; \
    else \
        pip install -r requirements.txt; \
    fi

# 预下载 embedding 模型到镜像层（/app/.modelcache），运行时容器无需联网下载
#
# 离线优先（推荐，在线通道不稳定时可靠）：构建前把本机缓存放到构建上下文
# models_cache/（见根目录 models_cache/README.md 的复制命令）——fastembed
# 命中缓存直接加载，下列 RUN 不产生网络请求；目录为空时行为与历史一致（在线下载）。
# 在线通道可用 --build-arg HF_ENDPOINT=https://hf-mirror.com 覆盖；
# HF_HUB_DISABLE_XET=1 关闭 XetHub（hf-mirror 不代理其 CAS，会 401）
ARG HF_ENDPOINT=https://huggingface.co
ENV HF_ENDPOINT=${HF_ENDPOINT} \
    HF_HUB_DISABLE_XET=1
COPY models_cache/ /app/.modelcache/
RUN python -c "from fastembed import TextEmbedding; TextEmbedding('BAAI/bge-small-zh-v1.5', cache_dir='/app/.modelcache')"

COPY src/ ./src/
COPY configs/ ./configs/
COPY scripts/ ./scripts/
# 迁移链（api 容器启动时执行 `alembic upgrade head` 建表/升级，见 docker-compose.yml）
COPY alembic.ini ./
COPY migrations/ ./migrations/

EXPOSE 8000

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
