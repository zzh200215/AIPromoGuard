# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# 环境变量与密钥
.env
.env.*
!.env.example

# 运行时数据（上传文档 / 报告 / 向量持久化）
data/

# IDE
.idea/
.vscode/
*.swp

# 系统
.DS_Store
Thumbs.db

# pytest basetemp（默认 Temp 目录权限受限时使用）
.pytest-tmp/
.pytest-tmp-db*/
.pytest-tmp*/

# AI 工作记忆不入库（每日日志/项目笔记属本地过程数据）；
# .workbuddy/skills/ 保留入库——项目 skill（如 frontend-visual-verify）需团队共享
.workbuddy/memory/

# 个人文档不入库（面试准备材料 / 截图）
面试说明稿.md
ScreenShot_*.png

# 工具生成
.superpowers/
docs/superpowers/

# 本地评估运行日志
*.log

# 内部开发任务笔记
tasks/

# 根目录 PRD 原件（正式版在 docs/PRD.md）
/金融产品合规智能审查系统*.md
.ci_sim/

ptmp_run/

# 离线模型缓存注入点（模型文件勿提交；说明与占位保留）
models_cache/*
!models_cache/README.md
!models_cache/.gitkeep

# staging 环境数据目录（独立于演示数据，运行时产物）
data_staging/

# 离线 wheel 兜底目录（wheel 文件不入库，占位保留；用法见 docker/Dockerfile.api 注释）
wheels/*.whl

# 会话级实时进度台（本地工具，非交付物）
.workbuddy/live/
