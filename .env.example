# ===== 应用 =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ===== LLM（QWEN / DashScope） =====
# DashScope API Key：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120

# ===== LLM 可观测性（Langfuse，可选） =====
# 两个 Key 均配置才启用埋点（调用链/trace/token 成本看板）；留空则完全 no-op。
# 自托管 Langfuse 时把 HOST 换成自己的地址。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=compliance_review

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== 向量库（MVP: chroma | 后续: milvus） =====
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma
# Milvus（切换时启用）
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# ===== 嵌入模型（本地部署 BGE，或走 DashScope） =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# ===== 知识图谱（Neo4j，W9 起使用） =====
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123

# ===== 安全 =====
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# ===== 存储 =====
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports
