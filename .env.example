# ===== 应用 =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ===== LLM（OpenAI 兼容网关：LLM 与 VLM 共用 Key 与 Base）=====
# 变量名 DASHSCOPE_API_KEY 为历史名（兼容旧部署），实际是"当前网关的 Key"。
# 当前接入：商汤日日新 Token Plan（公测免费：每模型 5 小时 1500 次）
#   Key 申请：https://platform.sensenova.cn/console/keys
#   可用模型：deepseek-v4-flash（经济高效）/ deepseek-flash / deepseek-v4.1-flash
#             / glm-5.2 / kimi-k3 / sensenova-6.8-flash-lite（多模态，VLM 用）
# 换提供商只需改 Key / BASE_URL / MODEL 三处（须 OpenAI 兼容端点）。
# 备选：DashScope https://dashscope.aliyuncs.com/compatible-mode/v1（qwen-plus / qwen-vl-plus）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://token.sensenova.cn/v1
LLM_TEMPERATURE=0.2
# 超时须覆盖"工具循环"（ReAct 法规查证 = 2~3 次往返；单块实测 35~65s）
LLM_TIMEOUT=240
# 网关按 RPM 限流时（并发审查块常见 429）：退避重试次数（3s→6s…）
LLM_RATE_LIMIT_RETRIES=2

# 视觉层审查（VLM，图片文档专用）：消息内 image_url（data URL）多模态模型
VLM_MODEL=sensenova-6.8-flash-lite

# ===== LLM 可观测性（Langfuse，可选） =====
# 两个 Key 均配置才启用埋点（调用链/trace/token 成本看板）；留空则完全 no-op。
# 自托管 Langfuse 时把 HOST 换成自己的地址。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=compliance_review

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== 向量库（MVP: chroma | 后续: milvus） =====
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma
# Milvus（切换时启用）
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# ===== 嵌入模型（本地部署 BGE，或走 DashScope） =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# ===== 知识图谱（Neo4j，W9 起使用） =====
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123

# ===== 安全 =====
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# ===== 存储 =====
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports
